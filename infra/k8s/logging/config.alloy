// Grafana Alloy: collects logs from every pod in the remotebpo namespace and sends them to Loki
// (Grafana Cloud). Runbook: docs/runbooks/centralized-logs.md

// 1. Find the pods in our namespace (Alloy itself is skipped)
discovery.kubernetes "pods" {
  role = "pod"
  namespaces {
    names = ["remotebpo"]
  }
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    regex         = "alloy"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

// 2. Read their logs through the Kubernetes API (no access to the node's disk needed)
loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.process.app.receiver]
}

// 3. Process: shared with the local test (test/config.test.alloy has the same block)
// --- PROCESS START ---
loki.process "app" {
  // Our API logs are JSON (docs/logging.md). Plain-text lines (web, redis) pass through unchanged.
  stage.json {
    expressions = {
      level       = "level",
      time        = "time",
      request_id  = "requestId",
      status      = "status",
      duration_ms = "durationMs",
    }
  }

  // Debug logs (health checks every few seconds) stay in the pod only
  stage.drop {
    source = "level"
    value  = "debug"
  }

  // Safety net: the API never logs tokens, but never ship one if a line has it
  stage.replace {
    expression = "(?i)bearer\\s+([A-Za-z0-9._~+/=-]+)"
    replace    = "[REDACTED]"
  }

  // level is a label (few values: fast to filter). requestId and status change on every
  // line, so they are structured metadata: searchable, but not labels (keeps Loki cheap)
  stage.labels {
    values = { level = "" }
  }
  stage.structured_metadata {
    values = {
      request_id  = "",
      status      = "",
      duration_ms = "",
    }
  }

  // Use the time the app wrote, not the time Alloy read the line
  stage.timestamp {
    source            = "time"
    format            = "RFC3339"
    action_on_failure = "skip"
  }

  forward_to = [loki.write.cloud.receiver]
}
// --- PROCESS END ---

// 4. Send to Grafana Cloud Logs. Values come from the Secret "grafana-cloud-logs" (never in Git)
loki.write "cloud" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USERNAME")
      password = sys.env("LOKI_PASSWORD")
    }
  }
  external_labels = {
    cluster = "remotebpo-staging",
  }
}
