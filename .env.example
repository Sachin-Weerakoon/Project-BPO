# RemoteBPO Hub: environment variables
# Copy to .env and fill in real values locally:  cp .env.example .env
# NEVER commit .env. Staging values live in GitHub Actions secrets and Kubernetes Secrets (docs/secrets.md).
# Which values are secrets, and where they live in staging: docs/secrets.md

# --- General ---
NODE_ENV=development

# --- Backend (apps/api) ---
API_PORT=5000
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Local: your own Postgres. Staging: Supabase pooler URL (from the deploy pipeline, never committed)
DATABASE_URL=postgresql://remotebpo:change_me@localhost:5432/remotebpo
# Migrations only. Local: same as DATABASE_URL. Staging: Supabase direct URL
DATABASE_DIRECT_URL=postgresql://remotebpo:change_me@localhost:5432/remotebpo
# Used by the local postgres container (Docker Compose)
POSTGRES_USER=remotebpo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=remotebpo
REDIS_URL=redis://localhost:6379
# Supabase: leave empty unless the API uses the Supabase client.
# SUPABASE_SERVICE_ROLE_KEY is server-only: never in a NEXT_PUBLIC_ variable
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# --- Email (verification, password reset, notifications) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASS=change_me
MAIL_FROM="RemoteBPO Hub <no-reply@example.com>"

# --- File storage (S3-compatible: resumes, logos) ---
# Local: MinIO keys. Staging: object storage keys in the api-secrets Kubernetes Secret.
S3_BUCKET=remotebpo-dev
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me

# --- Frontend (apps/web) ---
# NEXT_PUBLIC_ values are sent to the browser: never put secrets in them
NEXT_PUBLIC_API_URL=http://localhost:5000/api
